# Copie para .env.local e preencha com as chaves reais do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site, usada no sitemap e no robots (padrão: domínio de produção da Vercel)
# NEXT_PUBLIC_SITE_URL=https://thecrownlp.vercel.app

# Opcional: sobrescreve o vídeo de fundo do hero (padrão: /videos/hero-loop.mp4)
# NEXT_PUBLIC_HERO_VIDEO_URL=https://xxxx.supabase.co/storage/v1/object/public/midia/hero-loop.mp4

# Vídeo de abertura do show. Em produção a seção só aparece se esta variável estiver definida
# NEXT_PUBLIC_INTRO_VIDEO_URL=https://xxxx.supabase.co/storage/v1/object/public/midia/intro-video.mp4

# Painel de administração (/admin) — veja docs/ATIVAR-PAINEL.md
# E-mail da banda: único que recebe link de acesso e para onde vão os avisos
# ADMIN_EMAIL=
# Chave do Resend (resend.com) para avisar por e-mail sobre contatos e depoimentos novos
# RESEND_API_KEY=
# Opcional: remetente dos avisos (precisa de domínio verificado no Resend)
# NOTIFY_FROM=The Crown LP <site@seudominio.com.br>
