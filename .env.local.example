# Copie para .env.local e preencha com as chaves reais do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site, usada no sitemap e no robots (padrão: https://thecrownlp.com.br)
# NEXT_PUBLIC_SITE_URL=https://thecrownlp.com.br

# Opcional: sobrescreve o vídeo de fundo do hero (padrão: /videos/hero-loop.mp4)
# NEXT_PUBLIC_HERO_VIDEO_URL=https://xxxx.supabase.co/storage/v1/object/public/midia/hero-loop.mp4

# Vídeo de abertura do show. Em produção a seção só aparece se esta variável estiver definida
# NEXT_PUBLIC_INTRO_VIDEO_URL=https://xxxx.supabase.co/storage/v1/object/public/midia/intro-video.mp4
